{
  "name": "nodomics",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @nodomics/web --filter @nodomics/nodes-core dev",
    "check": "pnpm typecheck && pnpm lint && pnpm deps && pnpm names && pnpm format:check && pnpm test",
    "typecheck": "tsc -p . && pnpm -r --parallel --if-present typecheck",
    "lint": "eslint .",
    "deps": "depcruise packages apps tests --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @nodomics/e2e e2e",
    "prepare": "lefthook install",
    "names": "node scripts/check-file-names.ts",
    "anuncios": "node scripts/show-announcements.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook",
      "unrs-resolver",
      "esbuild"
    ]
  }
}
