{
  "format": "nodomics/flow@0",
  "nodes": [
    {
      "id": "source",
      "type": "core.source.sample",
      "version": "0.1.0",
      "params": {
        "dataset": "ventas"
      },
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "filter",
      "type": "core.filter",
      "version": "0.1.0",
      "params": {
        "column": "region",
        "op": "=",
        "value": "Norte"
      },
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "result",
      "type": "core.group",
      "version": "0.1.0",
      "params": {
        "groupBy": ["region"],
        "aggregations": [
          {
            "column": "unidades",
            "fn": "SUM",
            "name": "total"
          }
        ]
      },
      "position": {
        "x": 0,
        "y": 0
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": {
        "node": "source",
        "port": "out"
      },
      "to": {
        "node": "filter",
        "port": "in"
      }
    },
    {
      "id": "e2",
      "from": {
        "node": "filter",
        "port": "out"
      },
      "to": {
        "node": "result",
        "port": "in"
      }
    }
  ]
}
