{
  "cases": [
    {
      "name": "multiplies two columns",
      "params": {
        "name": "total",
        "column": "unidades",
        "op": "*",
        "otherColumn": "precio"
      },
      "inputs": {
        "in": {
          "columns": [
            {
              "name": "unidades",
              "type": "number"
            },
            {
              "name": "precio",
              "type": "number"
            }
          ],
          "rows": [
            [2, 1.5],
            [4, 2]
          ]
        }
      },
      "expected": {
        "out": {
          "columns": [
            {
              "name": "unidades",
              "type": "number"
            },
            {
              "name": "precio",
              "type": "number"
            },
            {
              "name": "total",
              "type": "number"
            }
          ],
          "rows": [
            [2, 1.5, 3],
            [4, 2, 8]
          ]
        }
      }
    },
    {
      "name": "operates a column with a value",
      "params": {
        "name": "doble",
        "column": "unidades",
        "op": "*",
        "value": 2
      },
      "inputs": {
        "in": {
          "columns": [
            {
              "name": "region",
              "type": "text"
            },
            {
              "name": "unidades",
              "type": "number"
            }
          ],
          "rows": [
            ["Norte", 5],
            ["Sur", 3],
            ["Norte", 2]
          ]
        }
      },
      "expected": {
        "out": {
          "columns": [
            {
              "name": "region",
              "type": "text"
            },
            {
              "name": "unidades",
              "type": "number"
            },
            {
              "name": "doble",
              "type": "number"
            }
          ],
          "rows": [
            ["Norte", 5, 10],
            ["Sur", 3, 6],
            ["Norte", 2, 4]
          ]
        }
      }
    }
  ]
}
