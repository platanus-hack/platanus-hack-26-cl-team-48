  {
    "id": "core.python.custom",
    "version": "0.1.0",
    "name": "Código Python",
    "description": "Transforma la tabla con tu propio código Python.",
    "category": "Python",
    "icon": "code",
    "inputs": [
      {
        "id": "in",
        "type": "table"
      }
    ],
    "outputs": [
      {
        "id": "out",
        "type": "table"
      }
    ],
    "params": {
      "type": "object",
      "properties": {
        "code": {
          "title": "Código",
          "type": "string",
          "default": "def transform(inputs):\n    return {\"out\": inputs[\"in\"]}\n",
          "x-nodomics": {
            "widget": "code",
            "language": "python"
          }
        },
        "columns": {
          "title": "Columnas de salida",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "title": "Nombre",
                "type": "string"
              },
              "type": {
                "title": "Tipo",
                "oneOf": [
                  {
                    "const": "number",
                    "title": "Número"
                  },
                  {
                    "const": "text",
                    "title": "Texto"
                  },
                  {
                    "const": "date",
                    "title": "Fecha"
                  },
                  {
                    "const": "bool",
                    "title": "Verdadero o falso"
                  }
                ],
                "default": "number"
              }
            },
            "required": ["name", "type"]
          },
          "default": [],
          "x-nodomics": {
            "widget": "port-schema",
            "port": "out"
          }
        },
        "mustShow": {
          "title": "Debe mostrar un gráfico",
          "type": "boolean",
          "default": false,
          "x-nodomics": {
            "widget": "switch",
            "requires": "display"
          }
        }
      },
      "required": ["code"]
    },
    "impl": {
      "kind": "python",
      "entry": "run",
      "code": "def run(inputs, params):\n    # The node exists to run the user's code: it must define transform(inputs).\n    namespace = {}\n    # Named so a traceback points to the lines of the user's code, which the editor marks.\n    exec(compile(params[\"code\"], \"<code>\", \"exec\"), namespace)\n    return namespace[\"transform\"](inputs)\n"
    },
    "requires": {
      "runtime": "python",
      "packages": ["pandas"]
    }
  },
  {
    "id": "core.python.zscore",
    "version": "0.1.0",
    "name": "Puntaje Z",
    "description": "Agrega el puntaje Z (desviaciones de la media) de una columna.",
    "category": "Python",
    "icon": "sigma",
    "inputs": [
      {
        "id": "in",
        "type": "table"
      }
    ],
    "outputs": [
      {
        "id": "out",
        "type": "table"
      }
    ],
    "params": {
      "type": "object",
      "properties": {
        "column": {
          "title": "Columna",
          "type": "string",
          "x-nodomics": {
            "widget": "column",
            "of": "in"
          }
        },
        "name": {
          "title": "Nombre",
          "type": "string",
          "default": "zscore"
        }
      },
      "required": ["column"]
    },
    "impl": {
      "kind": "python",
      "entry": "run",
      "code": "def run(inputs, params):\n    table = inputs[\"in\"].copy()\n    values = table[params[\"column\"]]\n    table[params.get(\"name\", \"zscore\")] = (values - values.mean()) / values.std(ddof=0)\n    return {\"out\": table}\n"
    },
    "requires": {
      "runtime": "python",
      "packages": ["pandas"]
    }
  },
  {
