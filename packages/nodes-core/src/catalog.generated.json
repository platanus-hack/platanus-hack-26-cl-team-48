  {
    "id": "core.filter",
    "version": "0.1.0",
    "name": "Filtrar",
    "description": "Conserva las filas que cumplen una condición.",
    "category": "Transformar",
    "icon": "filter",
    "inputs": [
      {
        "id": "in",
        "type": "table"
      }
    ],
    "outputs": [
      {
        "id": "out",
        "type": "table"
      }
    ],
    "params": {
      "type": "object",
      "properties": {
        "column": {
          "title": "Columna",
          "type": "string",
          "x-nodomics": {
            "widget": "column",
            "of": "in"
          }
        },
        "op": {
          "title": "Operador",
          "enum": ["=", "!=", ">", "<", ">=", "<=", "contiene"],
          "default": "="
        },
        "value": {
          "title": "Valor",
          "type": "string"
        }
      },
      "required": ["column", "value"]
    },
    "impl": {
      "kind": "sql",
      "template": "SELECT * FROM {{in}} WHERE {{#if (eq op 'contiene')}}CAST({{ident column}} AS VARCHAR) ILIKE {{lit (concat '%' value '%')}}{{else}}{{ident column}} {{op}} {{lit value}}{{/if}}"
    }
  },
  {
    "id": "core.formula",
    "version": "0.1.0",
    "name": "Columna calculada",
    "description": "Agrega una columna que opera otra columna con una columna o un valor.",
    "category": "Transformar",
    "icon": "calculator",
    "inputs": [
      {
        "id": "in",
        "type": "table"
      }
    ],
    "outputs": [
      {
        "id": "out",
        "type": "table"
      }
    ],
    "params": {
      "type": "object",
      "properties": {
        "name": {
          "title": "Nombre",
          "type": "string",
          "default": "resultado"
        },
        "column": {
          "title": "Columna",
          "type": "string",
          "x-nodomics": {
            "widget": "column",
            "of": "in"
          }
        },
        "op": {
          "title": "Operación",
          "enum": ["+", "-", "*", "/"],
          "default": "*"
        },
        "otherColumn": {
          "title": "Otra columna",
          "type": "string",
          "x-nodomics": {
            "widget": "column",
            "of": "in"
          }
        },
        "value": {
          "title": "Valor",
          "type": "number"
        }
      },
      "required": ["name", "column", "op"],
      "oneOf": [
        {
          "required": ["otherColumn"]
        },
        {
          "required": ["value"]
        }
      ]
    },
    "impl": {
      "kind": "sql",
      "template": "SELECT *, {{ident column}} {{op}} {{#if otherColumn}}{{ident otherColumn}}{{else}}{{lit value}}{{/if}} AS {{ident name}} FROM {{in}}"
    }
  },
  {
    "id": "core.group",
    "version": "0.1.0",
    "name": "Agrupar",
    "description": "Agrupa las filas y calcula agregaciones por grupo.",
    "category": "Transformar",
    "icon": "layers",
    "inputs": [
      {
        "id": "in",
        "type": "table"
      }
    ],
    "outputs": [
      {
        "id": "out",
        "type": "table"
      }
    ],
    "params": {
      "type": "object",
      "properties": {
        "groupBy": {
          "title": "Agrupar por",
          "type": "array",
          "items": {
            "title": "Columna",
            "type": "string",
            "x-nodomics": {
              "widget": "column",
              "of": "in"
            }
          },
          "default": []
        },
        "aggregations": {
          "title": "Agregaciones",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "column": {
                "title": "Columna",
                "type": "string",
                "x-nodomics": {
                  "widget": "column",
                  "of": "in"
                }
              },
              "fn": {
                "title": "Función",
                "enum": ["SUM", "AVG", "MIN", "MAX", "COUNT"],
                "default": "SUM"
              },
              "name": {
                "title": "Nombre",
                "type": "string"
              }
            },
            "required": ["column", "fn", "name"]
          }
        }
      },
      "required": ["aggregations"]
    },
    "impl": {
      "kind": "sql",
      "template": "SELECT {{#each groupBy}}{{ident this}}, {{/each}}{{#each aggregations}}{{#unless @first}}, {{/unless}}{{fn}}({{ident column}}) AS {{ident name}}{{/each}} FROM {{in}}{{#if groupBy}} GROUP BY {{#each groupBy}}{{#unless @first}}, {{/unless}}{{ident this}}{{/each}} ORDER BY {{#each groupBy}}{{#unless @first}}, {{/unless}}{{ident this}}{{/each}}{{/if}}"
    }
  },
  {
    "id": "core.join",
    "version": "0.1.0",
    "name": "Unir tablas",
    "description": "Une dos tablas por columnas que coinciden.",
    "category": "Transformar",
    "icon": "merge",
    "inputs": [
      {
        "id": "left",
        "name": "Izquierda",
        "type": "table"
      },
      {
        "id": "right",
        "name": "Derecha",
        "type": "table"
      }
    ],
    "outputs": [
      {
        "id": "out",
        "type": "table"
      }
    ],
    "params": {
      "type": "object",
      "properties": {
        "leftColumn": {
          "title": "Columna izquierda",
          "type": "string",
          "x-nodomics": {
            "widget": "column",
            "of": "left"
          }
        },
        "rightColumn": {
          "title": "Columna derecha",
          "type": "string",
          "x-nodomics": {
            "widget": "column",
            "of": "right"
          }
        },
        "how": {
          "title": "Tipo de unión",
          "enum": ["INNER", "LEFT", "RIGHT", "FULL"],
          "default": "INNER"
        }
      },
      "required": ["leftColumn", "rightColumn"]
    },
    "impl": {
      "kind": "sql",
      "template": "SELECT * FROM {{left}} AS l {{how}} JOIN {{right}} AS r ON l.{{ident leftColumn}} = r.{{ident rightColumn}}"
    }
  },
  {
    "id": "core.limit",
