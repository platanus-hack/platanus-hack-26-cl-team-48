  {
    "id": "core.view.line",
    "version": "0.1.0",
    "name": "Gráfico de líneas",
    "description": "Muestra cómo cambia un valor a lo largo de una fecha, un número o una categoría.",
    "category": "Vistas",
    "icon": "chart-line",
    "inputs": [
      {
        "id": "in",
        "type": "table"
      }
    ],
    "outputs": [
      {
        "id": "out",
        "type": "chart"
      }
    ],
    "params": {
      "type": "object",
      "properties": {
        "x": {
          "title": "Eje X",
          "type": "string",
          "x-nodomics": {
            "widget": "column",
            "of": "in",
            "types": ["date", "number", "text"]
          }
        },
        "y": {
          "title": "Eje Y",
          "type": "string",
          "x-nodomics": {
            "widget": "column",
            "of": "in",
            "types": ["number"]
          }
        },
        "aggregate": {
          "title": "Agregación",
          "oneOf": [
            {
              "const": "sum",
              "title": "Suma"
            },
            {
              "const": "mean",
              "title": "Promedio"
            },
            {
              "const": "count",
              "title": "Conteo"
            },
            {
              "const": "min",
              "title": "Mínimo"
            },
            {
              "const": "max",
              "title": "Máximo"
            }
          ],
          "default": "sum"
        },
        "timeUnit": {
          "title": "Agrupar fechas por",
          "oneOf": [
            {
              "const": null,
              "title": "Sin agrupar"
            },
            {
              "const": "yearmonthdate",
              "title": "Día"
            },
            {
              "const": "yearweek",
              "title": "Semana"
            },
            {
              "const": "yearmonth",
              "title": "Mes"
            },
            {
              "const": "yearquarter",
              "title": "Trimestre"
            },
            {
              "const": "year",
              "title": "Año"
            }
          ],
          "default": "yearmonth",
          "x-nodomics": {
            "when": {
              "param": "x",
              "types": ["date"]
            }
          }
        },
        "series": {
          "title": "Series",
          "type": "string",
          "x-nodomics": {
            "widget": "column",
            "of": "in",
            "types": ["text", "bool"]
          }
        }
      },
      "required": ["x", "y"]
    },
    "impl": {
      "kind": "view",
      "spec": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "mark": {
          "type": "line",
          "point": true
        },
        "encoding": {
          "x": {
            "field": "{{x}}",
            "type": "{{vegaType x}}",
            "timeUnit": {
              "unit": "{{timeUnit}}",
              "utc": true
            }
          },
          "y": {
            "field": "{{y}}",
            "type": "quantitative",
            "aggregate": "{{aggregate}}"
          },
          "color": {
            "field": "{{series}}",
            "type": "nominal"
          }
        }
      }
    }
  },
  {
    "id": "core.view.table",
    "version": "0.1.0",
    "name": "Tabla",
    "description": "Muestra las primeras filas de las columnas elegidas.",
    "category": "Vistas",
    "icon": "table-2",
    "inputs": [
      {
        "id": "in",
        "type": "table"
      }
    ],
    "outputs": [
      {
        "id": "out",
        "type": "chart"
      }
    ],
    "params": {
      "type": "object",
      "properties": {
        "columns": {
          "title": "Columnas",
          "type": "array",
          "minItems": 1,
          "items": {
            "title": "Columna",
            "type": "string",
            "x-nodomics": {
              "widget": "column",
              "of": "in"
            }
          }
        },
        "rows": {
          "title": "Filas",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 20
        }
      },
      "required": ["columns"]
    },
    "impl": {
      "kind": "view",
      "spec": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "transform": [
          {
            "window": [
              {
                "op": "row_number",
                "as": "fila"
              }
            ]
          },
          {
            "filter": "datum.fila <= {{rows}}"
          },
          {
            "fold": "{{columns}}",
            "as": ["columna", "valor"]
          }
        ],
        "encoding": {
          "x": {
            "field": "columna",
            "type": "nominal",
            "sort": "{{columns}}",
            "bandPosition": 0,
            "scale": {
              "type": "band",
              "paddingInner": 0,
              "paddingOuter": 0
            },
            "axis": {
              "orient": "top",
              "title": null,
              "labels": false,
              "ticks": false
            }
          },
          "y": {
            "field": "fila",
            "type": "ordinal",
            "axis": {
              "title": null,
              "labels": false,
              "ticks": false,
              "domain": false,
              "grid": true,
              "bandPosition": 1
            }
          }
        },
        "layer": [
          {
            "transform": [
              {
                "filter": "datum.fila == 1"
              }
            ],
            "mark": {
              "type": "text",
              "align": "left",
              "dx": 8,
              "dy": -12,
              "fontWeight": "bold"
            },
            "encoding": {
              "y": {
                "value": 0
              },
              "text": {
                "field": "columna"
              }
            }
          },
          {
            "mark": {
              "type": "text",
              "align": "left",
              "dx": 8
            },
            "encoding": {
              "text": {
                "field": "valor"
              }
            }
          }
        ]
      }
    }
  },
