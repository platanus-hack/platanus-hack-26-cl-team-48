# Copia este archivo a apps/web/.env.local y pide los valores al equipo (anuncio en docs/anuncios).
# Sin estas dos variables la app funciona igual, pero el hub corre en memoria: sin cuentas ni
# publicaciones reales. Ambas son públicas por diseño (van dentro de la app publicada); aun así,
# .env.local no se commitea.

# URL del proyecto de Supabase del hub (ADR 0018), por ejemplo https://<ref>.supabase.co
VITE_SUPABASE_URL=

# Clave publicable de Supabase (empieza con sb_publishable_). Nunca la clave secreta.
VITE_SUPABASE_PUBLISHABLE_KEY=
